<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="JobPortal — Find your dream job or hire top talent in the Philippines." />
    <title>@ViewData["Title"] — JobPortal</title>

    <!-- Google Fonts: Outfit (Century Gothic Aesthetic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="dashboard-wrapper">
        <!-- ─── Side Navigation Panel ─── -->
        @await Html.PartialAsync("_Navbar")

        <div class="dashboard-main">
            <!-- ─── Global Alerts ─── -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mx-4 mt-3 mb-0 rounded border-0 text-center fw-semibold shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mx-4 mt-3 mb-0 rounded border-0 text-center fw-semibold shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- ─── Main Content ─── -->
            <main class="dashboard-content px-4 py-4">
                @RenderBody()
            </main>

            <!-- ─── Clean Dashboard Footer ─── -->
            <footer class="dashboard-footer py-3 px-4 mt-auto">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-2 text-muted small border-top pt-3">
                    <div>
                        &copy; @DateTime.Now.Year JobPortal &mdash; School Project
                    </div>
                    <div>
                        Built with ASP.NET Core MVC, Dapper &amp; MySQL
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
