@{
    // Read session values to determine which nav links to show
    var userId   = Context.Session.GetString("userId");
    var role     = Context.Session.GetString("userRole");
    var fullName = Context.Session.GetString("fullName");

    bool isLoggedIn  = userId != null;
    bool isCompany   = role == "company";
    bool isApplicant = role == "applicant";
    bool isAdmin     = role == "admin";
}

<header class="jp-topbar" id="jp-topbar">
    <div class="jp-topbar-brand">

        <a class="jp-brand-link" asp-controller="Home" asp-action="Index" aria-label="JobPortal Home">
            <div class="jp-brand-icon">
                <i class="bi bi-layers-fill"></i>
            </div>
            <span class="jp-brand-name">Job<span class="jp-brand-accent">Portal</span></span>
        </a>

        <button id="jp-menu-toggle"
                class="jp-hamburger"
                type="button"
                aria-label="Toggle navigation menu"
                aria-expanded="false"
                aria-controls="jp-dropdown-nav">
            <span class="jp-hamburger-bar"></span>
            <span class="jp-hamburger-bar"></span>
            <span class="jp-hamburger-bar"></span>
        </button>

    </div>

    <nav id="jp-dropdown-nav"
         class="jp-dropdown-nav"
         aria-hidden="true"
         role="navigation"
         aria-label="Site navigation">

        <div class="jp-dropdown-inner">

            <div class="jp-dropdown-section-label">Menu</div>

            <ul class="jp-dropdown-list" role="list">
                <li>
                    <a class="jp-dropdown-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i>
                        <span>Home</span>
                    </a>
                </li>
                <li>
                    <a class="jp-dropdown-link" asp-controller="Jobs" asp-action="Index">
                        <i class="bi bi-search"></i>
                        <span>Browse Jobs</span>
                    </a>
                </li>
                <li>
                    <a class="jp-dropdown-link" asp-controller="Home" asp-action="About">
                        <i class="bi bi-info-circle"></i>
                        <span>About Portal</span>
                    </a>
                </li>
            </ul>

            @if (isLoggedIn)
            {
            <div class="jp-dropdown-section-label jp-dropdown-section-label--mt">
                @(isAdmin ? "Admin Panel" : isApplicant ? "Applicant Panel" : "Employer Panel")
            </div>

            <ul class="jp-dropdown-list" role="list">
                @if (isAdmin)
                    {
                <li>
                    <a class="jp-dropdown-link" asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-shield-lock"></i>
                        <span>Admin Dashboard</span>
                    </a>
                </li>
                <li>
                    <a class="jp-dropdown-link" asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-people"></i>
                        <span>User Management</span>
                    </a>
                </li>
                <li>
                    <a class="jp-dropdown-link" asp-controller="Admin" asp-action="Jobs">
                        <i class="bi bi-briefcase"></i>
                        <span>Manage Jobs</span>
                    </a>
                </li>
                    }
                    else if (isApplicant)
                    {
                <li>
                    <a class="jp-dropdown-link" asp-controller="Applications" asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>My Applications</span>
                    </a>
                </li>
                <li>
                    <a class="jp-dropdown-link" asp-controller="Applications" asp-action="Track">
                        <i class="bi bi-diagram-3"></i>
                        <span>Application Pipeline</span>
                    </a>
                </li>
                    }
                    else if (isCompany)
                    {
                <li>
                    <a class="jp-dropdown-link" asp-controller="Company" asp-action="Dashboard">
                        <i class="bi bi-grid"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a class="jp-dropdown-link" asp-controller="Jobs" asp-action="Create">
                        <i class="bi bi-plus-circle"></i>
                        <span>Post Job</span>
                    </a>
                </li>
                <li>
                    <a class="jp-dropdown-link" asp-controller="Company" asp-action="Profile">
                        <i class="bi bi-building-gear"></i>
                        <span>Edit Profile</span>
                    </a>
                </li>
                    }
            </ul>

            <div class="jp-dropdown-divider"></div>
            <div class="jp-dropdown-user-card">
                <div class="jp-dropdown-avatar @(isCompany ? "jp-avatar--company" : "")">
                    @(fullName?.Substring(0, 1).ToUpper())
                </div>
                <div class="jp-dropdown-user-info">
                    <div class="jp-dropdown-user-name">@fullName</div>
                    <div class="jp-dropdown-user-role">
                        @(isAdmin ? "Administrator" : isApplicant ? "Applicant Account" : "Employer Account")
                    </div>
                </div>
                <a class="jp-dropdown-logout"
                   asp-controller="Auth"
                   asp-action="Logout"
                   title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
            }
            else
            {
            <div class="jp-dropdown-divider"></div>
            <div class="jp-dropdown-auth-btns">
                <a class="jp-btn-outline" asp-controller="Auth" asp-action="Login">
                    Sign In
                </a>
                <a class="jp-btn-gold" asp-controller="Auth" asp-action="Register">
                    Get Started
                </a>
            </div>
            }

        </div>
    </nav>
</header>```

