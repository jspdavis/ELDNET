@{
    // Read session values to determine which nav links to show
    var userId   = Context.Session.GetString("userId");
    var role     = Context.Session.GetString("userRole");
    var fullName = Context.Session.GetString("fullName");
    bool isLoggedIn = userId != null;
    bool isCompany  = role == "company";
    bool isApplicant= role == "applicant";
}

<nav class="navbar navbar-expand-lg navbar-dark site-navbar sticky-top">
    <div class="container">

        <!-- Brand Logo -->
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            <i class="bi bi-briefcase-fill me-2 text-primary"></i>JobPortal
        </a>

        <!-- Mobile Toggler -->
        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">

            <!-- Left Links -->
            <ul class="navbar-nav me-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Jobs" asp-action="Index">Browse Jobs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                </li>
            </ul>

            <!-- Right Links — changes based on session role -->
            <ul class="navbar-nav ms-auto align-items-center gap-2">

                @if (!isLoggedIn)
                {
                    <!-- Guest: show Login and Register -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm px-4" asp-controller="Auth" asp-action="Register">
                            Get Started
                        </a>
                    </li>
                }
                else if (isApplicant)
                {
                    <!-- Applicant: show My Applications -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Applications" asp-action="Index">
                            <i class="bi bi-file-earmark-text me-1"></i>My Applications
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="nav-avatar">@(fullName?.Substring(0,1).ToUpper())</div>
                            <span class="d-none d-lg-inline">@fullName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                            <li><span class="dropdown-item-text text-muted small">Applicant Account</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else if (isCompany)
                {
                    <!-- Company: show Dashboard and Post Job -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Company" asp-action="Dashboard">
                            <i class="bi bi-grid me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm px-4" asp-controller="Jobs" asp-action="Create">
                            <i class="bi bi-plus-lg me-1"></i>Post Job
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="nav-avatar company">@(fullName?.Substring(0,1).ToUpper())</div>
                            <span class="d-none d-lg-inline">@fullName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                            <li><span class="dropdown-item-text text-muted small">Company Account</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Company" asp-action="Profile">
                                    <i class="bi bi-building me-2"></i>Edit Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </a>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
