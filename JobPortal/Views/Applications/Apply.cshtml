@model JobPortal.Models.ViewModels.ApplicationViewModel
@{
    ViewData["Title"] = "Apply — " + Model.JobTitle;
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">

                <!-- Job Reference Banner -->
                <div class="apply-banner mb-4 p-4">
                    <p class="text-muted small mb-1">You are applying for:</p>
                    <h4 class="text-white fw-bold mb-0">@Model.JobTitle</h4>
                    <p class="text-muted mb-0">
                        <i class="bi bi-building me-1"></i>@Model.CompanyName
                    </p>
                </div>

                <div class="form-card p-4 p-md-5">
                    <h2 class="form-card-title mb-1">Write Your Cover Letter</h2>
                    <p class="text-muted small mb-4">
                        Tell the employer why you are the best candidate for this role.
                        Minimum 50 characters.
                    </p>

                    <form asp-controller="Applications" asp-action="Apply" asp-route-jobId="@Model.JobId"
                          method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <input type="hidden" asp-for="JobId" />
                        <input type="hidden" asp-for="JobTitle" />
                        <input type="hidden" asp-for="CompanyName" />

                        <div class="mb-4">
                            <label asp-for="CoverLetter" class="form-label fw-semibold text-light"></label>
                            <textarea asp-for="CoverLetter" class="form-control dark-input" rows="10"
                                      placeholder="Dear Hiring Manager,&#10;&#10;I am excited to apply for the @Model.JobTitle position at @Model.CompanyName..."></textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <span asp-validation-for="CoverLetter" class="text-danger small"></span>
                                <span class="text-muted small" id="charCount">0 characters</span>
                            </div>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="bi bi-send-fill me-2"></i>Submit Application
                            </button>
                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@Model.JobId"
                               class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Live character counter for cover letter textarea
        const textarea  = document.querySelector('textarea[name="CoverLetter"]');
        const charCount = document.getElementById('charCount');
        if (textarea && charCount) {
            textarea.addEventListener('input', () => {
                const len = textarea.value.length;
                charCount.textContent = `${len} character${len !== 1 ? 's' : ''}`;
                charCount.className   = len >= 50 ? 'text-success small' : 'text-warning small';
            });
        }
    </script>
}
