@model JobPortal.Models.ViewModels.EditCompanyProfileViewModel
@{
    ViewData["Title"] = "Edit Company Profile";
}

<section class="auth-section d-flex align-items-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">

                <div class="auth-card p-4 p-md-5">
                    <div class="mb-4 text-center">
                        <h1 class="auth-title">Edit Company Profile</h1>
                        <p class="text-muted small">Update your company's details and contact info</p>
                    </div>

                    <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="CompanyName" class="form-label text-muted small fw-semibold">Company Name</label>
                            <input asp-for="CompanyName" class="form-control dark-input" required />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label text-muted small fw-semibold">Contact Person Name</label>
                            <input asp-for="FullName" class="form-control dark-input" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label text-muted small fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control dark-input" rows="5" maxlength="2000"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label text-muted small fw-semibold"></label>
                                <input asp-for="Location" class="form-control dark-input" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Website" class="form-label text-muted small fw-semibold"></label>
                                <input asp-for="Website" class="form-control dark-input" placeholder="https://..." />
                                <span asp-validation-for="Website" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-semibold flex-fill">
                                <i class="bi bi-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg flex-fill d-flex align-items-center justify-content-center">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
