@model JobPortal.Models.ViewModels.EditApplicantProfileViewModel
@{
    ViewData["Title"] = "Edit Applicant Profile";
}

<section class="auth-section d-flex align-items-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">

                <div class="auth-card p-4 p-md-5">
                    <div class="mb-4 text-center">
                        <h1 class="auth-title">Edit Profile</h1>
                        <p class="text-muted small">Update your personal details and bio</p>
                    </div>

                    <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label text-muted small fw-semibold"></label>
                            <input asp-for="FullName" class="form-control dark-input" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label text-muted small fw-semibold"></label>
                                <input asp-for="Phone" class="form-control dark-input" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label text-muted small fw-semibold"></label>
                                <input asp-for="Location" class="form-control dark-input" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Bio" class="form-label text-muted small fw-semibold"></label>
                            <textarea asp-for="Bio" class="form-control dark-input" rows="5" maxlength="2000" id="bioTextarea"></textarea>
                            <div class="form-text text-muted text-end mt-1 small"><span id="bioCounter">0</span> / 2000</div>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-3 mt-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-semibold flex-fill">
                                <i class="bi bi-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg flex-fill d-flex align-items-center justify-content-center">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const textarea = document.getElementById('bioTextarea');
            const counter = document.getElementById('bioCounter');
            function updateCounter() {
                if (counter && textarea) {
                    counter.textContent = textarea.value.length;
                }
            }
            if (textarea) {
                textarea.addEventListener('input', updateCounter);
                updateCounter();
            }
        });
    </script>
}