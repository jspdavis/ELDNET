@model JobPortal.Models.JobPosting
@{
    ViewData["Title"] = Model.Title;
    var hasApplied    = (bool)(ViewBag.HasApplied ?? false);
    var role          = Context.Session.GetString("userRole");
    var isLoggedIn    = Context.Session.GetString("userId") != null;
}

<section class="py-5">
    <div class="container">
        <div class="row g-4">

            <!-- ─── Left: Job Details ─── -->
            <div class="col-lg-8">

                <!-- Back Link -->
                <a asp-controller="Jobs" asp-action="Index" class="btn-back mb-4 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Back to Listings
                </a>

                <div class="detail-card p-4 p-md-5">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                        <div>
                            <span class="badge-category mb-2">@Model.CategoryName</span>
                            <h1 class="detail-title mb-1">@Model.Title</h1>
                            <p class="detail-company">
                                <i class="bi bi-building me-1"></i>@Model.CompanyName
                            </p>
                        </div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success px-3 py-2">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">Closed</span>
                        }
                    </div>

                    <!-- Meta Info Row -->
                    <div class="detail-meta-row d-flex flex-wrap gap-4 mb-5">
                        <div class="detail-meta-item">
                            <i class="bi bi-geo-alt-fill text-primary"></i>
                            <span>@Model.Location</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.SalaryRange))
                        {
                            <div class="detail-meta-item">
                                <i class="bi bi-cash-stack text-primary"></i>
                                <span>@Model.SalaryRange</span>
                            </div>
                        }
                        <div class="detail-meta-item">
                            <i class="bi bi-calendar3 text-primary"></i>
                            <span>Posted @Model.PostedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="detail-section mb-4">
                        <h4 class="section-heading">Job Description</h4>
                        <p class="text-muted lh-lg">@Model.Description</p>
                    </div>

                    <!-- Requirements -->
                    @if (!string.IsNullOrEmpty(Model.Requirements))
                    {
                        <div class="detail-section mb-4">
                            <h4 class="section-heading">Requirements</h4>
                            <p class="text-muted lh-lg">@Model.Requirements</p>
                        </div>
                    }
                </div>
            </div>

            <!-- ─── Right: Apply Sidebar ─── -->
            <div class="col-lg-4">
                <div class="apply-sidebar sticky-top" style="top: 90px;">
                    <div class="detail-card p-4">
                        <h5 class="fw-bold text-slate mb-4">Apply for this Position</h5>

                        @if (!isLoggedIn)
                        {
                            <p class="text-muted small mb-4">You need to be logged in as an applicant to apply.</p>
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary w-100 mb-2">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Login to Apply
                            </a>
                            <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-light w-100">
                                Create an Account
                            </a>
                        }
                        else if (role == "company")
                        {
                            <div class="alert-info-custom">
                                <i class="bi bi-info-circle me-2"></i>
                                Company accounts cannot apply to jobs.
                            </div>
                        }
                        else if (hasApplied)
                        {
                            <div class="applied-badge">
                                <i class="bi bi-check-circle-fill me-2 text-success"></i>
                                You have already applied for this job.
                            </div>
                            <a asp-controller="Applications" asp-action="Index" class="btn btn-outline-light w-100 mt-3">
                                View My Applications
                            </a>
                        }
                        else if (Model.IsActive)
                        {
                            <p class="text-muted small mb-4">Submit your cover letter to apply for this role.</p>
                            <a asp-controller="Applications" asp-action="Apply" asp-route-jobId="@Model.JobId"
                               class="btn btn-primary w-100 btn-lg">
                                <i class="bi bi-send me-2"></i>Apply Now
                            </a>
                        }
                        else
                        {
                            <div class="alert-info-custom">
                                <i class="bi bi-x-circle me-2 text-danger"></i>
                                This job is no longer accepting applications.
                            </div>
                        }

                        <!-- Company Quick Info -->
                        <hr class="my-4" style="border-color: #333;" />
                        <h6 class="text-muted small text-uppercase fw-semibold mb-3">About the Company</h6>
                        <p class="text-slate fw-semibold mb-1">@Model.CompanyName</p>
                        <p class="text-muted small">
                            <i class="bi bi-geo-alt me-1"></i>@Model.Location
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
