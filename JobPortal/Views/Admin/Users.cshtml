@model IEnumerable<JobPortal.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<!-- ── Page Hero ── -->
<div class="page-hero mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <p class="text-muted small mb-1 fw-semibold" style="letter-spacing:.08em; text-transform:uppercase;">
                <i class="bi bi-shield-lock-fill me-1"></i>Administration
            </p>
            <h1 class="page-hero-title mb-1">User <strong>Management</strong></h1>
            <p class="text-muted mb-0" style="font-size:.92rem;">
                @Model.Count() registered user@(Model.Count() == 1 ? "" : "s") — companies and applicants.
            </p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
</div>

<!-- ── Users Table ── -->
<div class="table-card form-card p-0 overflow-hidden">

    @if (!Model.Any())
    {
        <div class="text-center py-5 px-4">
            <div class="feature-icon mx-auto mb-3" style="width:60px;height:60px;font-size:1.6rem;">
                <i class="bi bi-people"></i>
            </div>
            <h5 class="fw-semibold" style="color:var(--text-primary);">No users found</h5>
            <p class="text-muted small">No company or applicant accounts have been registered yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr class="table-head">
                        <th>#</th>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Registered</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @{ int userRow = 0; }
                @foreach (var user in Model)
                {
                    userRow++;
                    <tr>
                        <td class="text-muted" style="font-size:.8rem; font-weight:600;">
                            @userRow
                        </td>

                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="nav-avatar-custom @(user.Role == "company" ? "company" : "")" style="width:36px;height:36px;font-size:.8rem;flex-shrink:0;">
                                    @(string.IsNullOrEmpty(user.FullName) ? "?" : user.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <span class="fw-semibold" style="color:var(--text-primary); font-size:.92rem;">
                                    @user.FullName
                                </span>
                            </div>
                        </td>

                        <td class="text-muted" style="font-size:.88rem;">@user.Email</td>

                        <td>
                            @if (user.Role == "company")
                            {
                                <span class="badge-salary">
                                    <i class="bi bi-building me-1"></i>Company
                                </span>
                            }
                            else
                            {
                                <span class="badge-category">
                                    <i class="bi bi-person me-1"></i>Applicant
                                </span>
                            }
                        </td>

                        <td class="text-muted" style="font-size:.85rem;">
                            <i class="bi bi-calendar3 me-1"></i>@user.CreatedAt.ToString("MMM dd, yyyy")
                        </td>

                        <td class="text-end">
                            <form asp-action="DeleteUser"
                                  asp-route-id="@user.UserId"
                                  method="post"
                                  onsubmit="return confirm('Delete @user.FullName? This cannot be undone.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                                    <i class="bi bi-trash3 me-1"></i>Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

</div>
