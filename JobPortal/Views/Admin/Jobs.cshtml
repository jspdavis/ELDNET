@model IEnumerable<JobPortal.Models.JobPosting>

@{
    ViewData["Title"] = "All Job Listings";
}

<div class="container mt-4">

    <h2>All Job Listings</h2>

    <table class="table table-dark table-striped mt-4">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Posted</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.JobId</td>
                <td>@job.Title</td>

                <td>
                    @if (job.IsActive)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inactive
                        </span>
                    }
                </td>

                <td>@job.PostedAt</td>

                <td>
                    <form asp-action="DeleteJob"
                          asp-route-id="@job.JobId"
                          method="post"
                          onsubmit="return confirm('This will permanently delete the job and all its applications. Continue?');">

                        <button class="btn btn-danger btn-sm">
                            Delete Permanently
                        </button>

                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <a asp-action="Dashboard"
       class="btn btn-secondary">
        Back
    </a>

</div>