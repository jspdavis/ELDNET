@model IEnumerable<JobPortal.Models.JobPosting>

@{
    ViewData["Title"] = "Job Listings";
    var activeCount   = Model.Count(j => j.IsActive);
    var inactiveCount = Model.Count(j => !j.IsActive);
}

<!-- ── Page Hero ── -->
<div class="page-hero mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <p class="text-muted small mb-1 fw-semibold" style="letter-spacing:.08em; text-transform:uppercase;">
                <i class="bi bi-shield-lock-fill me-1"></i>Administration
            </p>
            <h1 class="page-hero-title mb-1">Job <strong>Listings</strong></h1>
            <p class="text-muted mb-0" style="font-size:.92rem;">
                @Model.Count() total &mdash;
                <span style="color:var(--accent-orange);">@activeCount active</span>,
                @inactiveCount inactive.
            </p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
</div>

<!-- ── Jobs Table ── -->
<div class="table-card form-card p-0 overflow-hidden">

    @if (!Model.Any())
    {
        <div class="text-center py-5 px-4">
            <div class="feature-icon mx-auto mb-3" style="width:60px;height:60px;font-size:1.6rem;">
                <i class="bi bi-briefcase"></i>
            </div>
            <h5 class="fw-semibold" style="color:var(--text-primary);">No job listings found</h5>
            <p class="text-muted small">No jobs have been posted yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr class="table-head">
                        <th>#</th>
                        <th>Job Title</th>
                        <th>Company</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Posted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @{ int jobRow = 0; }
                @foreach (var job in Model)
                {
                    jobRow++;
                    <tr>
                        <td class="text-muted" style="font-size:.8rem; font-weight:600;">
                            @jobRow
                        </td>

                        <td>
                            <span class="fw-semibold" style="color:var(--text-primary); font-size:.92rem;">
                                @job.Title
                            </span>
                        </td>

                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-building" style="color:var(--accent-teal); font-size:.85rem;"></i>
                                <span class="text-muted" style="font-size:.88rem;">@job.CompanyName</span>
                            </div>
                        </td>

                        <td>
                            <span class="badge-category">@job.CategoryName</span>
                        </td>

                        <td>
                            @if (job.IsActive)
                            {
                                <span class="status-badge status-accepted">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem; vertical-align:middle;"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-rejected">
                                    <i class="bi bi-circle me-1" style="font-size:.45rem; vertical-align:middle;"></i>Inactive
                                </span>
                            }
                        </td>

                        <td class="text-muted" style="font-size:.85rem;">
                            <i class="bi bi-calendar3 me-1"></i>@job.PostedAt.ToString("MMM dd, yyyy")
                        </td>

                        <td class="text-end">
                            <form asp-action="DeleteJob"
                                  asp-route-id="@job.JobId"
                                  method="post"
                                  onsubmit="return confirm('Permanently delete \'@job.Title\' and all its applications?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                                    <i class="bi bi-trash3 me-1"></i>Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

</div>
