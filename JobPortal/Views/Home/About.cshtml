@{
    ViewData["Title"] = "About JobPortal";
}

<section class="page-hero py-5 mb-2">
    <div class="container">
        <h1 class="page-hero-title">About JobPortal</h1>
        <p class="text-muted">Connecting talent with opportunity across the Philippines.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <h2 class="section-title mb-4">Our Mission</h2>
                <p class="text-muted lh-lg">
                    JobPortal is a school project built to demonstrate a full-stack ASP.NET Core MVC application
                    with a real MySQL database, Dapper ORM, and Bootstrap 5 frontend. It simulates a real-world
                    job board platform for the Philippines.
                </p>
                <p class="text-muted lh-lg">
                    Our goal is to provide a clean, fast, and easy-to-use platform where applicants can find
                    their next opportunity and companies can attract the right talent — without the noise.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="detail-card p-4">
                    <h5 class="fw-bold text-white mb-4">Tech Stack</h5>
                    <ul class="list-unstyled tech-list">
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>ASP.NET Core MVC (.NET 8)</li>
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>MySQL Database</li>
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>Dapper (Micro ORM)</li>
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>BCrypt.Net-Next (Password Hashing)</li>
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>Bootstrap 5 + Vanilla JS</li>
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>Session-Based Authentication</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Contact -->
        <div class="row mt-5 g-4">
            <div class="col-md-4">
                <div class="feature-card p-4">
                    <div class="feature-icon mb-3"><i class="bi bi-envelope-fill"></i></div>
                    <h6 class="fw-bold text-white mb-2">Email Us</h6>
                    <p class="text-muted small mb-0">support@jobportal.ph</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card p-4">
                    <div class="feature-icon mb-3"><i class="bi bi-geo-alt-fill"></i></div>
                    <h6 class="fw-bold text-white mb-2">Location</h6>
                    <p class="text-muted small mb-0">Metro Manila, Philippines</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card p-4">
                    <div class="feature-icon mb-3"><i class="bi bi-clock-fill"></i></div>
                    <h6 class="fw-bold text-white mb-2">Office Hours</h6>
                    <p class="text-muted small mb-0">Mon–Fri, 9AM – 6PM PHT</p>
                </div>
            </div>
        </div>
    </div>
</section>
