@{
    ViewData["Title"] = "Error";
}

<section class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="text-center">
        <div class="feature-icon mb-4 mx-auto" style="width:80px;height:80px;font-size:2rem;">
            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
        </div>
        <h1 class="fw-bold text-white mb-2">Something went wrong</h1>
        <p class="text-muted mb-4">An unexpected error occurred. Please try again or return to the home page.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-5">
            <i class="bi bi-house me-2"></i>Go Home
        </a>
    </div>
</section>
