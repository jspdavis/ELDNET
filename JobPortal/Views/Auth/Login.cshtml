@model JobPortal.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-section d-flex align-items-center min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">

                <div class="auth-card p-4 p-md-5">
                    <!-- Logo / Brand -->
                    <div class="text-center mb-4">
                        <div class="auth-logo mb-3">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>
                        <h1 class="auth-title">Welcome Back</h1>
                        <p class="text-muted small">Sign in to your JobPortal account</p>
                    </div>

                    <form asp-controller="Auth" asp-action="Login" method="post"
                          class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Global Error (wrong credentials) -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-muted small fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text dark-input-prefix">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Email" class="form-control dark-input"
                                       placeholder="you@example.com" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label text-muted small fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text dark-input-prefix">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Password" class="form-control dark-input"
                                       placeholder="••••••••" autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg fw-semibold mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>

                        <p class="text-center text-muted small mb-0">
                            Don't have an account?
                            <a asp-controller="Auth" asp-action="Register" class="text-primary fw-semibold">
                                Register here
                            </a>
                        </p>
                    </form>
                </div>

                <!-- Demo credentials hint -->
                <div class="text-center mt-3">
                    <small class="text-muted">
                        Demo: <code class="text-primary">alice@example.com</code> / <code class="text-primary">Password123!</code>
                    </small>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
