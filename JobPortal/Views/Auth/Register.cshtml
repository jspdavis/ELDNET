@model JobPortal.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<section class="auth-section d-flex align-items-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">

                <div class="auth-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="auth-logo mb-3">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                        <h1 class="auth-title">Create Account</h1>
                        <p class="text-muted small">Join JobPortal as a job seeker or employer</p>
                    </div>

                    <form asp-controller="Auth" asp-action="Register" method="post"
                          class="needs-validation" novalidate id="registerForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <!-- Role Selection -->
                        <div class="mb-4">
                            <label class="form-label text-muted small fw-semibold">I am registering as a…</label>
                            <div class="role-selector d-flex gap-3">
                                <label class="role-option flex-fill" id="roleApplicantLabel">
                                    <input type="radio" asp-for="Role" value="applicant"
                                           class="d-none role-radio" id="roleApplicant" checked />
                                    <div class="role-card" id="roleApplicantCard">
                                        <i class="bi bi-person-fill fs-3 mb-2 d-block"></i>
                                        <span class="fw-semibold">Job Seeker</span>
                                        <small class="d-block text-muted">Browse &amp; apply to jobs</small>
                                    </div>
                                </label>
                                <label class="role-option flex-fill" id="roleCompanyLabel">
                                    <input type="radio" asp-for="Role" value="company"
                                           class="d-none role-radio" id="roleCompany" />
                                    <div class="role-card" id="roleCompanyCard">
                                        <i class="bi bi-building fs-3 mb-2 d-block"></i>
                                        <span class="fw-semibold">Employer</span>
                                        <small class="d-block text-muted">Post jobs &amp; hire talent</small>
                                    </div>
                                </label>
                            </div>
                            <span asp-validation-for="Role" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label text-muted small fw-semibold"></label>
                            <input asp-for="FullName" class="form-control dark-input"
                                   placeholder="Your full name" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-muted small fw-semibold"></label>
                            <input asp-for="Email" class="form-control dark-input"
                                   placeholder="you@example.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Password Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label text-muted small fw-semibold"></label>
                                <input asp-for="Password" class="form-control dark-input"
                                       placeholder="Min 8 characters" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label text-muted small fw-semibold"></label>
                                <input asp-for="ConfirmPassword" class="form-control dark-input"
                                       placeholder="Repeat password" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Company Fields (hidden unless "company" role selected) -->
                        <div id="companyFields" class="company-fields-section d-none">
                            <hr class="my-3" style="border-color: #333;" />
                            <p class="text-muted small fw-semibold mb-3">
                                <i class="bi bi-building me-1 text-primary"></i>Company Details
                            </p>

                            <div class="mb-3">
                                <label asp-for="CompanyName" class="form-label text-muted small fw-semibold"></label>
                                <input asp-for="CompanyName" class="form-control dark-input"
                                       placeholder="Your company's name" id="companyNameInput" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CompanyDescription" class="form-label text-muted small fw-semibold"></label>
                                <textarea asp-for="CompanyDescription" class="form-control dark-input" rows="3"
                                          placeholder="A brief description of your company…"></textarea>
                                <span asp-validation-for="CompanyDescription" class="text-danger small"></span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="CompanyLocation" class="form-label text-muted small fw-semibold"></label>
                                    <input asp-for="CompanyLocation" class="form-control dark-input"
                                           placeholder="e.g. Makati, Manila" />
                                    <span asp-validation-for="CompanyLocation" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CompanyWebsite" class="form-label text-muted small fw-semibold"></label>
                                    <input asp-for="CompanyWebsite" class="form-control dark-input"
                                           placeholder="https://yourcompany.com" />
                                    <span asp-validation-for="CompanyWebsite" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg fw-semibold mt-2 mb-3">
                            <i class="bi bi-person-check me-2"></i>Create Account
                        </button>

                        <p class="text-center text-muted small mb-0">
                            Already have an account?
                            <a asp-controller="Auth" asp-action="Login" class="text-primary fw-semibold">Sign in</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function updateRoleUI() {
            const isCompany = document.getElementById('roleCompany').checked;

            const applicantCard = document.getElementById('roleApplicantCard');
            const companyCard = document.getElementById('roleCompanyCard');

            applicantCard.classList.remove('selected');
            companyCard.classList.remove('selected');

            if (isCompany) {
                companyCard.classList.add('selected');
            } else {
                applicantCard.classList.add('selected');
            }
        }

        document.querySelectorAll('.role-radio').forEach(radio => {
            radio.addEventListener('change', updateRoleUI);
        });

        // run on page load
        document.addEventListener('DOMContentLoaded', updateRoleUI);
    </script>
}
